{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tmmmagic.eu"
        }
      ],
      "destination": "https://tmmmagic.eu/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz.html/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/magic-book",
      "destination": "/"
    },
    {
      "source": "/capitoli",
      "destination": "/"
    },
    {
      "source": "/magic-book/capitolo-:chapter",
      "destination": "/"
    },
    {
      "source": "/magic-book/esame-pdf",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/quiz",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/capitolo-:chapter",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/multi",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/esame-:mode",
      "destination": "/quiz"
    }
  ]
}
