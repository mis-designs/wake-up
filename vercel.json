{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/quiz.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tmmmagic.eu"
        }
      ],
      "destination": "https://tmmmagic.eu/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz.html/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/join",
      "destination": "/"
    },
    {
      "source": "/magic-book",
      "destination": "/"
    },
    {
      "source": "/capitoli",
      "destination": "/"
    },
    {
      "source": "/magic-book/capitolo-:chapter",
      "destination": "/"
    },
    {
      "source": "/magic-book/esame-pdf",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/quiz",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/capitolo-:chapter",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/multi",
      "destination": "/quiz"
    },
    {
      "source": "/quiz/esame-:mode",
      "destination": "/quiz"
    }
  ]
}
