# Copy these names into the hosting provider's encrypted environment settings.
# Never put real values in this file.

# Authentication and access backend
GAS_ACCESS_URL=
GAS_SECRET=
GAS_ADMIN_KEY=
SESSION_SECRET=
ADMIN_LOGIN_PASSWORD=
ADMIN_PHONE_NUMBERS=

# Five-day promo code (Production only; update both values, then redeploy)
PROMO_CODE_5_DAYS=
PROMO_CODE_5_DAYS_EXPIRES_AT=
PROMO_ALLOWED_HOSTS=

# OTP provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Quiz backend
QUIZ_GAS_URL=
QUIZ_PROXY_SECRET=

# Bound Google Sheet Learning Database web app URL
MAGICBOOK_LEARNING_DB=

# Private R2 storage for MagicBook and allow-listed app assets
# Disable the bucket's public r2.dev URL and any public custom domain.
BOOK_R2_BUCKET=
BOOK_R2_ACCOUNT_ID=
BOOK_R2_ACCESS_KEY_ID=
BOOK_R2_SECRET_ACCESS_KEY=

# Quiz audio storage
QUIZ_AUDIO_R2_BUCKET=
QUIZ_AUDIO_R2_ACCOUNT_ID=
QUIZ_AUDIO_R2_ACCESS_KEY_ID=
QUIZ_AUDIO_R2_SECRET_ACCESS_KEY=

# Explanation storage
EXPLANATION_R2_BUCKET=
EXPLANATION_R2_ACCOUNT_ID=
EXPLANATION_R2_ACCESS_KEY_ID=
EXPLANATION_R2_SECRET_ACCESS_KEY=

# Database (configure one canonical URL; aliases are supported by the API)
DATABASE_URL=
